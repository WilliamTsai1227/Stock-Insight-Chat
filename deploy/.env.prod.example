# EC2 生產環境 .env 範例（複製為 .env 後填入真實值，勿 commit）
#
# docker compose -f docker-compose.prod.yml 會讀取同目錄的 .env

# ── Docker Hub 映像（compose 變數替換用）────────────────────────
DOCKERHUB_USER=your-dockerhub-user
IMAGE_TAG=1.0.0
# 探索（Kinetic Charts）映像 tag；容器環境變數見 .env.kinetic.example
KINETIC_TAG=1.0.0

# ⚠️ 勿使用行內註解（KEY=value  # 說明）。
#    Compose 的 env_file parser 可能把 "# 說明" 當成值的一部分送進容器。
#    註解請像本檔一樣獨立成行。
#
# 完整變數清單與預設值見 specifications/env.md

# ── 應用程式（backend env_file 會注入容器）──────────────────────
DATABASE_URL=postgresql://user:password@your-rds-endpoint.ap-northeast-1.rds.amazonaws.com:5432/Insight
# RDS 強制 TLS 時必填（asyncpg 不吃連線字串上的 ?ssl=require）
DATABASE_SSL=require

OPENAI_API_KEY=
TAVILY_API_KEY=
SECRET_KEY=

# MongoDB：news.py 讀 MONGO_URI、ai_analysis.py 讀 MONGODB_URL，兩個都要設且值相同
MONGO_URI=
MONGODB_URL=
MONGO_DB=stock_insight

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/user/auth/google/callback

FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
COOKIE_SECURE=true

# ── 延遲調校（可選；不設則用程式預設）──────────────────────────
# 改這些不需要重 build image，改完 up -d backend 即可（restart 不會重讀 env）
ROUTER_REASONING_EFFORT=minimal
ANALYST_REASONING_EFFORT=low
ANALYST_TARGET_MAX_WORDS=1800
