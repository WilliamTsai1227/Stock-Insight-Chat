# ═══════════════════════════════════════════════════════════════
# Stock Insight Chat — 環境變數範本
# 使用方式：cp .env.example .env，填入實際值（.env 已在 .gitignore，勿提交）
# 完整說明見 specifications/env.md；快捷模式調參見 specifications/readme_full_details.md
# ═══════════════════════════════════════════════════════════════

# ─── 安全性（正式環境必改）────────────────────────────────────
# JWT 簽名密鑰：openssl rand -hex 32
SECRET_KEY=
# RT Cookie 的 Secure 屬性：本機 HTTP 開發 false；正式 HTTPS 必須 true
COOKIE_SECURE=false

# ─── OpenAI（必填）────────────────────────────────────────────
OPENAI_API_KEY=

# ─── PostgreSQL（必填；指向外部 DB，如 AWS RDS）───────────────
# 格式：postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ─── MongoDB（必填；新聞／分析文稿來源）───────────────────────
# 注意：news.py 讀 MONGO_URI，ai_analysis.py 讀 MONGODB_URL，請設為相同值
MONGO_URI=
MONGODB_URL=
MONGO_DB=stock_insight

# ─── Qdrant（本機 Docker 時 compose 已設 QDRANT_HOST=qdrant）──
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Google SSO（登入必填）────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/user/auth/google/callback
FRONTEND_URL=http://localhost

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ─── 一般對話（chat_mode=general）──────────────────────────────
# 預設模型；只能是白名單內的 id（gpt-5.6-luna / gpt-5.4-mini），
# 使用者可在輸入框旁的下拉選單自行切換（GET /api/chat/models 回傳清單）
# GENERAL_CHAT_MODEL=gpt-5.6-luna
# 思考強度；留空＝走模型預設（medium，明顯較慢）。
# 最低檔名稱跨世代不同（gpt-5 系列=minimal、gpt-5.1 以後=none），
# 程式會依模型自動對齊，非推理模型則不帶此參數。
# GENERAL_CHAT_REASONING_EFFORT=low

# ─── 一般對話即時搜尋（選用；需 Tavily API key）───────────────
# 走 Tavily，不是模型內建的 web search（那需要 Responses API）
# GENERAL_CHAT_ENABLE_WEB_SEARCH=1
# TAVILY_API_KEY=

# ─── Agent Context 調參（選用；皆有程式內預設值）──────────────
# ROUTER_HISTORY_TURNS=2            # Router 保留幾輪跨對話歷史
# CONTEXT_CHAIN_MAX_HOPS=6          # 從 DB 遞迴載入歷史訊息上限
# HISTORY_ASSISTANT_MAX_CHARS=800   # DB 歷史中 Analyst 回答截斷上限
# MAX_TOOL_ITEM_CHARS=500           # Router 所見 ToolMessage 截斷上限

# ─── 快捷模式 Flash（選用；皆有程式內預設值）──────────────────
# FLASH_SKIP_ROUTER=1               # 1=略過 Router LLM（較快）
# FLASH_ANALYST_MODEL=gpt-5-mini
# FLASH_ANALYST_MAX_TOKENS=2800     # 過小會被 reasoning token 吃光可見正文
# FLASH_RETRIEVAL_TOP_K=10
# FLASH_LLM_QUERY_REWRITE=0         # 1=檢索前以小模型收成 query
# FLASH_REWRITE_DUAL_SEARCH=1       # 1=原文與改寫並行雙軌檢索＋合併去重
# FLASH_REWRITE_MODEL=gpt-4o-mini

# ─── 深度研究 Deep Research（OpenAI Agents SDK）────────────────
# 模型固定為白名單內的 id（目前只有 gpt-5.6-luna）。白名單外的值會被忽略並記在 log ——
# 換模型等於換一組費率，而費率表（module/token_usage.py）與配額扣點都綁在 model id 上。
DEEP_SEARCH_MODEL=gpt-5.6-luna
# 以下皆選用，未設定時使用程式內預設值
# DEEP_SEARCH_MODELS=gpt-5.6-luna       # 前端可選清單；只能縮減白名單，不能擴充
# DEEP_SEARCH_MAX_FILES=10             # 單次研究可上傳的檔案數
# DEEP_SEARCH_MAX_FILE_MB=20           # 單一檔案大小上限
# DEEP_SEARCH_MAX_IMAGES=4             # 單次研究可附的圖片數
# DEEP_SEARCH_QUERY_MAX_CHARS=4000     # 研究題目字數上限
# DEEP_SEARCH_MAX_TURNS=24             # Agent 迴圈上限（web search 會用掉數輪）
# DEEP_SEARCH_DECK_SLIDES=12           # 簡報頁數預設值（前端可改 5–20）
# DEEP_SEARCH_REPORT_SECTIONS=6        # 報告小節數預設值（前端可改 3–10）
# DEEP_SEARCH_SESSION_TTL_MINUTES=120  # 記憶體 session 存活時間
# DEEP_SEARCH_MAX_SESSIONS_PER_USER=5  # 每位使用者保留的 session 數

# ─── 回饋 API 防濫用（選用）───────────────────────────────────
# FEEDBACK_DAILY_MAX=3
# FEEDBACK_TOKEN_REWARD=2500
# TURNSTILE_SITE_KEY=               # Cloudflare Turnstile（與 secret 同時設定才啟用）
# TURNSTILE_SECRET_KEY=
